# Copy to .env.local for local dev. In production set these in Vercel:
# Project → Settings → Environment Variables. Never commit real values.

# Neon Postgres connection string.
# Neon dashboard → your project → Connection Details → pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Shared password the Aster team types to get in.
# Use something long. Generate one: openssl rand -base64 24
TEAM_PASSWORD="change-me-to-something-long"

# Signs the session cookie. Must be random and secret.
# Generate: openssl rand -hex 32
SESSION_SECRET="change-me-64-hex-chars"

# Bearer token for POST /api/leads/batch, so Claude can write batches in.
# Generate: openssl rand -hex 32
INGEST_TOKEN="change-me-64-hex-chars"
